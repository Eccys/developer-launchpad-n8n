            {
              "name": "api-key",
              "value": "YOUR_DEVTO_API_KEY_HERE"
            }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\"article\": {\"title\": \"{{$node[\"Set Launch Vars\"].json[\"title\"]}}\", \"published\": false, \"body_markdown\": \"## Just Launched!\\n\\n{{$node[\"Set\"].json[\"description\"]}}\\n\\nCheck it out here: [{{$node[\"Set Launch Vars\"].json[\"title\"]}}]({{$node[\"Set Launch Vars\"].json[\"url\"]}})\", \"tags\": [\"opensource\", \"github\", \"showdev\"]}}"
      },
      "name": "Dev.to Draft Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        800,
        360
      ]
    },
    {
      "parameters": {
        "content": "=🚀 **New Project Launched!**\n\n**Title:** {{$node[\"Set Launch Vars\"].json[\"title\"]}}\n**Link:** {{$node[\"Set Launch Vars\"].json[\"url\"]}}\n\n👉 **Click here to submit to Hacker News:**\nhttps://news.ycombinator.com/submitlink?u={{encodeURIComponent($node[\"Set Launch Vars\"].json[\"url\"])}}&t={{encodeURIComponent($node[\"Set Launch Vars\"].json[\"title\"])}}"
      },
      "name": "Discord Alert",
      "type": "n8n-nodes-base.discord",
