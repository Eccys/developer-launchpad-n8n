            },
            {
              "name": "description",
              "value": "={{$json[\"body\"][\"description\"]}}"
            }
          ]
        },
        "options": {}
      },
      "name": "Set Launch Vars",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        560,
        300
      ]
    },
    {
      "parameters": {
        "subreddit": "github",
