        "url": "={{$node[\"Set Launch Vars\"].json[\"url\"]}}"
      },
      "name": "Reddit Post",
      "type": "n8n-nodes-base.reddit",
      "typeVersion": 1,
      "position": [
        800,
        140
      ]
